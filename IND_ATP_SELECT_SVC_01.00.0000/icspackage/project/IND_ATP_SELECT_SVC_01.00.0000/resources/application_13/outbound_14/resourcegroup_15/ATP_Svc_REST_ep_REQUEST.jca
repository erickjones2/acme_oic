<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/ATP_Svc_REST_ep_REQUEST/types" name="ATP_Svc_REST_ep_REQUESTPortType" adapter="REST" wsdlLocation="ATP_Svc_REST_ep_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.rest.RestAdapterConnectionFactory">
      <property name="cloud.adapter.plugin.init.version" value="25.04.0"/>
      <property name="cloud.adapter.plugin.version" value="25.04.0"/>
      <property name="cloud.adapter.sdk.init.version" value="25.04.0"/>
      <property name="cloud.adapter.sdk.version" value="25.04.0"/>
      <property name="privateEndpoint" value="false"/>
      <property name="rest.inbound.security.configurable" value="true"/>
      <property name="security" value="oracle/multi_token_rest_service_policy"/>
      <property name="securityPolicy" value="MULTI_TOKEN_INBOUND"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-activation portType="ATP_Svc_REST_ep_REQUESTPortType" operation="execute">
    <activation-spec className="oracle.tip.adapter.cloud.CloudActivationSpec">
      <property name="targetOperation" value="execute"/>
      <property name="HTTPHeadersAdded" value="true"/>
      <property name="HttpVerb" value="GET"/>
      <property name="QueryParameters" value="cust_Id"/>
      <property name="ResourceURI" value="/svc/atp"/>
      <property name="ResponseElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/ATP_Svc_REST_ep/types"/>
      <property name="ResponseElementName" value="response-wrapper"/>
      <property name="ResponseMediaType" value="application/json"/>
      <property name="ResponseSample" value="[ { &quot;cust_first_name&quot;:&quot;Abigail&quot;, &quot;cust_gender&quot;:&quot;M&quot;, &quot;cust_street_address&quot;:&quot;37 West Geneva Street&quot; } ]"/>
      <property name="allowChangeDefaultNamespace" value="false"/>
      <property name="copyFaultFromModel" value="true"/>
      <property name="generateConnectivityPropertiesInboundRequest" value="RESTINREQ"/>
      <property name="generateConnectivityPropertiesInboundResponse" value="RESTINRES"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="generateSecurityPropertiesInboundRequest" value="SECURITYPROPSRESTINREQ"/>
      <property name="integrationSchemaNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/ATP_Svc_REST_ep_REQUEST/types"/>
      <property name="integrationWSDLNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/ATP_Svc_REST_ep_REQUEST"/>
      <property name="invocationStyle" value="REQUEST_RESPONSE"/>
      <property name="isResponseJsonSchema" value="false"/>
      <property name="isResponseRawBytes" value="false"/>
      <property name="operations" value="default"/>
      <property name="postQueryParamsAsContent" value="false"/>
      <property name="responseJsonTopLevelArray" value="true"/>
    </activation-spec>
  </endpoint-activation>
</adapter-config>